#!name=Emby Public Service Enhance (Legacy)
#!desc=Experimental and legacy: applies only to mb3admin.com. It does not support self-hosted or arbitrary Emby servers.
#!category=Streaming

[MITM]
hostname = %APPEND% mb3admin.com

[Script]
emby-public-playback = type=http-response,pattern=^https?:\/\/mb3admin\.com\/admin\/service\/registration\/validateDevice,requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/rartv/EmbyPublic/test/surge/unlock.js,script-update-interval=0
