#!name=Sub-Store
#!desc=Sub-Store compatibility wrapper using official release-branch assets.
#!openUrl=https://sub.store
#!author=Peng-YM
#!homepage=https://github.com/sub-store-org/Sub-Store
#!icon=https://raw.githubusercontent.com/58xinian/icon/master/Sub-Store1.png

[Argument]
cron=input, "55 23 * * *", tag=Sync Schedule, desc=CRON expression for syncing configuration
sync_success_notify=switch, true, tag=Sync Notification, desc=Notify when synchronization succeeds
cors=input, "https://sub-store.vercel.app,http://substore.stash,https://substore.stash", tag=CORS Origins, desc=Allowed web origins; do not use *

[Rule]
# Use the profile's dedicated selector so the frontend can use a working route
# while the plugin itself remains downloadable over DIRECT during bootstrap.
DOMAIN,sub-store.vercel.app,Sub-Store

[MITM]
hostname=sub.store

[Script]
http-request ^https?:\/\/sub\.store\/((download)|api\/(preview|sync|(utils\/node-info))) script-path=https://raw.githubusercontent.com/sub-store-org/Sub-Store/release/sub-store-1.min.js, requires-body=true,max-size=-1, timeout=900, tag=Sub-Store Core, argument=[{cors}]
http-request ^https?:\/\/sub\.store script-path=https://raw.githubusercontent.com/sub-store-org/Sub-Store/release/sub-store-0.min.js, requires-body=true,max-size=-1, timeout=900, tag=Sub-Store Simple, argument=[{cors}]
cron {cron} script-path=https://raw.githubusercontent.com/sub-store-org/Sub-Store/release/cron-sync-artifacts.min.js, timeout=900, tag=Sub-Store Sync, argument=[{sync_success_notify,cors}]
