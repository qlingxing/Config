#!name=Loon Subscription Parser
#!desc=Official Sub-Store parser compatibility wrapper for Loon 3.5.0 (969) or newer.
#!tag=Parser,Sub-Store
#!loon_version=3.5.0(969)
#!author=Peng-YM
#!homepage=https://github.com/sub-store-org/Sub-Store
#!icon=https://raw.githubusercontent.com/58xinian/icon/master/Sub-Store1.png
#!type=parser

[Argument]
resourceUrlOnly = switch,true,tag=Remote Resources Only,desc=Ignore Loon's built-in subscription parsing data
ua = input,"",tag=User-Agent,desc=User-Agent used when fetching subscriptions
timeout = input,8000,tag=Fetch Timeout,desc=Timeout in milliseconds when fetching subscriptions
noCache = switch,false,tag=Disable Cache,desc=Disable parser cache
age-secret-key = input,"",tag=Age Secret Key,desc=Age decryption private key

[Script]
generic script-path=https://raw.githubusercontent.com/sub-store-org/Sub-Store/release/sub-store-parser.loon.min.js,tag=Sub-Store Parser,timeout=900,argument=[{ua},{resourceUrlOnly},{noCache},{timeout},{age-secret-key}]
